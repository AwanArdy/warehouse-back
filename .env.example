NODE_ENV=development
PORT=3000

# PostgreSQL 16+
DATABASE_URL=postgres://warehouse_user:warehouse_secret@localhost:5432/warehouse_db
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Document Storage ('local' untuk dev lokal, 's3' untuk S3/MinIO/R2)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# Konfigurasi di bawah ini hanya wajib jika STORAGE_DRIVER=s3
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=warehouse-documents

# Keamanan & Auth (Dipakai penuh di Milestone 2)
JWT_ACCESS_SECRET=ganti_dengan_random_secret_minimal_32_karakter_aman
JWT_REFRESH_SECRET=ganti_dengan_refresh_secret_minimal_32_karakter_beda

# Mesin Kompilasi LaTeX
LATEX_BIN=xelatex
LATEX_TIMEOUT_MS=10000
