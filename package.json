{
  "name": "backend-gudang",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts test/**/*.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "seed": "tsx src/db/seed.ts",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate:up": "node --env-file=.env node_modules/.bin/node-pg-migrate up",
    "migrate:down": "node --env-file=.env node_modules/.bin/node-pg-migrate down",
    "migrate:reset": "node --env-file=.env node_modules/.bin/node-pg-migrate down 0 && node --env-file=.env node_modules/.bin/node-pg-migrate up",
    "migrate:create": "node-pg-migrate create"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "argon2": "^0.45.2",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "jose": "^6.2.18",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "node-pg-migrate": "^7.9.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "keywords": [],
  "type": "module"
}
